# docker-compose.yml için gerçek değerleri buradan alır.
# Kopyala: cp .env.example .env  (sonra .env dosyasını gerçek değerlerle doldur, ASLA commit'leme)

POSTGRES_DB=TaskManagementDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# En az 32 karakter, rastgele üretilmiş bir değer olmalı
JWT_KEY=change_me_use_a_long_random_secret
JWT_ISSUER=TaskManagementAPI
JWT_AUDIENCE=TaskManagementClient

# Tarayıcıdan uygulamaya erişilecek port (frontend container'ı bu porttan yayınlanır)
FRONTEND_PORT=8081
